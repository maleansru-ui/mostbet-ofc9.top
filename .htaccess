##############################################
# .htaccess — mostbet-ofc9.top
# Порядок: PHP → HTTPS → WWW → URL → Безопасность → Заголовки → Кэш → Сжатие
##############################################

# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
    AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler


##############################################
# 1. REWRITE ENGINE
##############################################
<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -Indexes

    # ── HTTPS-редирект ──────────────────────
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ── non-www → www (выбери одно из двух) ─
    # Вариант A: принудительно без www (рекомендую, у тебя canonical без www)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Вариант B: принудительно с www — раскомментируй и закомментируй вариант A
    # RewriteCond %{HTTP_HOST} !^www\. [NC]
    # RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ── Партнёрская ссылка ───────────────────
    RewriteRule ^mostbet/?$ https://qydnte.com/8BPU?sub1=mostbet-ofc9.top [R=302,L,NE]

    # ── Блокировка Chrome 44 (бот 2015 года) ─
    RewriteCond %{HTTP_USER_AGENT} Chrome/44 [NC]
    RewriteRule .* - [F,L]

    # ── Убрать index.html из URL ─────────────
    RewriteCond %{THE_REQUEST} ^.*/index\.html [NC]
    RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

    # ── Убрать расширение .html ──────────────
    # Редирект с .html → без .html
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*[^\.]+\.html\ HTTP/
    RewriteRule ^(([^/]+/)*[^\.]+)\.html$ /$1 [R=301,L]

    # Внутренний map: URL без .html → файл .html
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]

    # ── JS MIME-тип ──────────────────────────
    RewriteRule ^.*\.js$ - [T=text/javascript]

</IfModule>


##############################################
# 2. БЛОКИРОВКА УЯЗВИМЫХ ФАЙЛОВ
##############################################
<FilesMatch "(xmlrpc\.php|wp-login\.php|wp-signup\.php|phpinfo\.php|info\.php|_phpinfo\.php|\.env|\.git|composer\.(json|lock)|package\.json)">
    Require all denied
</FilesMatch>

# Запрет доступа к .htaccess и .htpasswd
<Files ~ "^\.ht">
    Require all denied
</Files>

# Запрет к резервным копиям
<FilesMatch "\.(bak|old|orig|save|swp|tmp|~)$">
    Require all denied
</FilesMatch>


##############################################
# 3. HTTP-ЗАГОЛОВКИ БЕЗОПАСНОСТИ И SEO
##############################################
<IfModule mod_headers.c>

    # ── Безопасность ─────────────────────────
    Header always set X-Content-Type-Options    "nosniff"
    Header always set X-Frame-Options           "SAMEORIGIN"
    Header always set X-XSS-Protection         "1; mode=block"

    # HSTS — только после проверки что HTTPS работает!
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Реферер — strict-origin-when-cross-origin лучше для аналитики
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # ── CORS ─────────────────────────────────
    Header always set Access-Control-Allow-Origin "*"

    # ── Убрать лишние заголовки ──────────────
    Header unset X-Robots-Tag
    Header always unset X-Powered-By
    Header always unset Server

    # ── Кэш по умолчанию (переопределяется ниже по типам) ──
    Header set Cache-Control "public, max-age=14400, must-revalidate"

</IfModule>


##############################################
# 4. КЭШИРОВАНИЕ ПО ТИПАМ ФАЙЛОВ
##############################################
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML — не кэшируем (свежий контент для SEO)
    ExpiresByType text/html                     "access plus 0 seconds"

    # CSS / JS — 30 дней (с версионированием в URL)
    ExpiresByType text/css                      "access plus 30 days"
    ExpiresByType application/javascript        "access plus 30 days"
    ExpiresByType text/javascript               "access plus 30 days"

    # Изображения — 1 год
    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/gif                     "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType image/x-icon                  "access plus 1 year"
    ExpiresByType image/ico                     "access plus 1 year"

    # Шрифты — 1 год
    ExpiresByType font/woff                     "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType application/font-woff         "access plus 1 year"
    ExpiresByType application/font-woff2        "access plus 1 year"

    # Данные
    ExpiresByType application/json              "access plus 0 seconds"
    ExpiresByType application/xml               "access plus 1 day"
    ExpiresByType text/xml                      "access plus 1 day"
</IfModule>

# Отдельные Cache-Control заголовки по типам
<IfModule mod_headers.c>
    # HTML — no-cache (важно для SEO-индексации)
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header unset Expires
    </FilesMatch>

    # Статика с длинным кэшем
    <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # CSS / JS
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000, must-revalidate"
    </FilesMatch>
</IfModule>


##############################################
# 5. GZIP-СЖАТИЕ
##############################################
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2

    # Не сжимаем уже сжатое
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|gz|zip|bz2|rar|7z)$ no-gzip dont-vary
    Header append Vary Accept-Encoding
</IfModule>


##############################################
# 6. СТРАНИЦА ОШИБОК
##############################################
ErrorDocument 400 /index.html
ErrorDocument 403 /index.html
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html
